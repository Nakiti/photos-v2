NODE_ENV=
LOG_LEVEL=info

DATABASE_URL=

JWT_SECRET=

# Redis. Preferred: a single connection URL (managed Redis usually provides this).
# Use the rediss:// scheme for TLS, e.g. rediss://default:password@host:6380
REDIS_URL=
# Fallback discrete vars (used only when REDIS_URL is unset). Good for local dev.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
CLOUDFRONT_BASE_URL=

# Firebase Admin credentials. In PRODUCTION use the base64-encoded service
# account JSON (no file to mount/leak) or Application Default Credentials —
# FIREBASE_SERVICE_ACCOUNT_PATH is ignored when NODE_ENV=production and is only
# honoured outside production for local-dev convenience.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Error tracking (Sentry). Leave SENTRY_DSN blank to disable (no-op).
SENTRY_DSN=
# Optional: defaults to NODE_ENV if unset.
SENTRY_ENVIRONMENT=
# Optional: release/version tag for grouping events (e.g. a git SHA).
SENTRY_RELEASE=

# Baseline API rate limit (per IP / per authenticated user). Optional — defaults
# to 300 requests per 60s window if unset.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Express `trust proxy` setting. Set to the number of trusted proxy hops in
# front of the app (e.g. 1 behind a single load balancer) so req.ip — and the
# rate limiters that key on it — use the real client IP instead of a spoofable
# X-Forwarded-For header. Accepts a hop count, "true"/"false", or a comma list
# of trusted IPs/subnets. Defaults to false (trust nothing) — set this in prod.
TRUST_PROXY=1

# Short-TTL (seconds) in-process cache for the per-request JWT user lookup,
# avoiding a DB read on every authenticated request. Optional — defaults to 30s.
# A deleted user stays authenticated until their cache entry expires.
JWT_USER_CACHE_TTL_SECONDS=30
