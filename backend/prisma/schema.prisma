generator client {
  provider = "prisma-client-js"
}

// Define MySQL as the provider
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Connection string from .env
}

// --- Model Definitions ---

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  password  String
  handle    String    @unique
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownedGalleries Gallery[]     @relation("OwnedGalleries")
  memberships    Membership[]
  photos         Photo[]
  photoLikes     PhotoLike[]
  devices        Device[]
  ownedCommunities    Community[]           @relation("OwnedCommunities")
  communityMemberships CommunityMembership[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications Notification[] @relation("SentNotifications")
}

model Gallery {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  iconUrl   String?
  type      GalleryType // GROUP or EVENT
  lastPhotoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startDate     DateTime?
  endDate       DateTime?
  location      String?
  shareableLink String?   @unique

  addPermission        GalleryAddPermission      @default(ADMIN)
  deletePermission     GalleryDeletePermission   @default(ADMINS_AUTHORS)
  editPermission       GalleryEditPermission     @default(ADMIN)

  joinCode           String?  @unique

  defaultTagId       String? @unique
  photoCount         Int      @default(0)
  memberCount        Int      @default(0)
  uploadLimitPerHour Int      @default(200)

  communityId String? 
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)


  owner       User         @relation("OwnedGalleries", fields: [ownerId], references: [id], onDelete: Cascade) // Cascade delete if owner is deleted (adjust if needed)
  memberships Membership[]
  photos      Photo[]
  tags        Tag[]

  @@index([ownerId])
  @@index([communityId])
  @@index([lastPhotoAt])
}

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addPermission        GalleryAddPermission      @default(ADMIN)
  deletePermission     GalleryDeletePermission   @default(ADMINS_AUTHORS)
  memberCount          Int      @default(0)
  galleryCount         Int      @default(0)

  joinCode             String?  @unique

  owner       User                  @relation("OwnedCommunities", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships CommunityMembership[]
  galleries   Gallery[]             

  @@index([ownerId])
}

model CommunityMembership {
  id          String   @id @default(uuid())
  userId      String
  communityId String
  joinedAt    DateTime @default(now())
  role        MembershipRole @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

enum GalleryType {
  GROUP
  EVENT
}

enum GalleryAddPermission {
  ANYONE
  ADMIN
}

enum GalleryDeletePermission {
  ADMINS_AUTHORS
  ADMIN
}

enum GalleryEditPermission {
  ADMIN
  ANYONE
}

enum MembershipRole {
  ADMIN   
  MEMBER  
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  galleryId String
  joinedAt  DateTime @default(now())
  role      MembershipRole   @default(MEMBER)
  isMuted   Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade delete if user is deleted
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade) // Cascade delete if gallery is deleted

  @@unique([userId, galleryId])
  @@index([userId])
  @@index([galleryId])
}

enum PhotoVisibility {
  IN_REVIEW
  VISIBLE
}

model Photo {
  id          String   @id @default(uuid())
  galleryId   String
  uploaderId  String
  s3Key       String   @unique
  s3Url       String
  thumbnailUrl String?
  thumbnailKey String?
  visible     PhotoVisibility @default(VISIBLE)
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  gallery  Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  uploader User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  photoTags PhotoTag[]
  likes     PhotoLike[]

  @@index([galleryId, deletedAt])
  @@index([uploaderId])
  @@index([visible])
}

model PhotoLike {
  id        String   @id @default(uuid())
  photoId   String
  userId    String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([photoId])
  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  galleryId String
  color     String?

  gallery  Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade) // Cascade delete if gallery is deleted
  photoTags PhotoTag[]

  @@unique([galleryId, name])
  @@index([galleryId])
}

model PhotoTag {
  id      String @id @default(uuid())
  photoId String
  tagId   String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade) // Cascade delete if photo is deleted
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade) // Cascade delete if tag is deleted

  @@unique([photoId, tagId])
  @@index([photoId])
  @@index([tagId])
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade delete if user is deleted

  @@index([userId])
}

enum NotificationType {
  LIKE
  COMMENT
  INVITE
  SYSTEM
}

model Notification {
  id            String          @id @default(uuid())
  recipientId   String
  actorId       String
  type          NotificationType
  referenceId   String?
  referenceType String? // 'Photo' | 'Gallery' | etc.
  data          Json? // JSONB field for snapshots: thumbnail_url, gallery_name, preview_text
  isRead        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  recipient User @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([actorId])
  @@index([isRead])
  @@index([createdAt])
}
